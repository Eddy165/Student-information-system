# Replace each value and store it in your deployment secret manager, not in Git.
SIS_ENV=production
SIS_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/sis?sslmode=verify-full
SIS_ALLOWED_HOSTS=sis.example.edu
SIS_CUSTOM_DOMAIN_VERIFIED=no
SIS_ORG_NAME=YOUR_INSTITUTION_NAME
SIS_LEGAL_ENTITY=YOUR_LEGAL_ENTITY_NAME
SIS_CONTACT_EMAIL=privacy@example.edu
SIS_POLICY_EFFECTIVE_DATE=YYYY-MM-DD
SIS_PRIVACY_FILE=/etc/sis/privacy-approved.txt
SIS_TERMS_FILE=/etc/sis/terms-approved.txt
SIS_POLICIES_APPROVED=no
